# Скопируйте в .env и заполните значениями из проекта в Lovable.
# Значения VITE_* используются при сборке (docker build / npm run build),
# остальные — при работе сервера.

# --- Браузерная часть (встраиваются в сборку) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Серверная часть ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=<project-ref>
# Секретный ключ (service role) — только для сервера, никогда не показывать публично
SUPABASE_SERVICE_ROLE_KEY=...

# --- Lovable AI (если на сайте используются AI-функции) ---
LOVABLE_API_KEY=...

# --- Google Maps (карта филиалов) ---
GOOGLE_MAPS_API_KEY=...
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=...
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=...

# --- Секрет для cron-эндпоинтов (если настроены внешние планировщики) ---
LOVABLE_CRON_SECRET=...
